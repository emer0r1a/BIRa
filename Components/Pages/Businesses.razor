@page "/businesses"
@layout DashboardLayout
@implements IDisposable
@inject WorkspaceState Workspace
@inject NavigationManager Nav

<PageTitle>My businesses | BIRa</PageTitle>

@* ============ HEADER ============ *@
<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <h1 class="text-3xl font-extrabold leading-tight tracking-tighter sm:text-5xl">My businesses</h1>
        <p class="mt-1 max-w-xl text-[#5B6B7F]">Every registration you manage, each with its own tax regime, RDO and deadlines.</p>
    </div>
    <button type="button" class="inline-flex w-fit items-center gap-3 rounded-full bg-gradient-to-r from-[#001F3E] to-[#0F69C5] py-1.5 pl-5 pr-1.5 text-sm font-bold text-white transition hover:brightness-110" @onclick="OpenAdd">
        Add a business
        <span class="grid h-8 w-8 place-items-center rounded-full bg-[#ADEE68] text-lg font-extrabold text-[#001F3E]" aria-hidden="true">+</span>
    </button>
</div>

@if (notice is not null)
{
    <div class="mt-6 flex items-start justify-between gap-4 rounded-2xl bg-[#ADEE68] px-5 py-3.5 text-sm font-semibold text-[#001F3E]" role="status">
        <p>@notice</p>
        <button type="button" class="shrink-0 font-bold underline-offset-2 hover:underline" @onclick="() => notice = null">Dismiss</button>
    </div>
}

@* ============ BUSINESS CARDS ============ *@
<div class="mt-6 grid gap-5 xl:grid-cols-2">
    @foreach (var b in Workspace.Businesses)
    {
        <BusinessCard Item="b" Today="Workspace.Today" IsCurrent="b == Workspace.Current"
                      Deadlines="Workspace.DeadlinesFor(b.Id).ToList()"
                      OnSwitch="SwitchTo" OnOpenDashboard="OpenDashboard" OnEdit="OpenEdit" />
    }

    <button type="button" class="flex min-h-[18rem] flex-col items-center justify-center gap-2 rounded-[1.75rem] border-2 border-dashed border-[#C9D6E6] p-6 text-center text-[#5B6B7F] transition hover:border-[#0F69C5] hover:bg-white hover:text-[#001F3E]" @onclick="OpenAdd">
        <span class="grid h-14 w-14 place-items-center rounded-full bg-[#EEF3F9] text-3xl" aria-hidden="true">+</span>
        <span class="text-lg font-extrabold text-[#001F3E]">Add a business</span>
        <span class="max-w-[16rem] text-sm">Managing another registration? Add it here and switch between them in one tap.</span>
    </button>
</div>

@* ============ COR GUIDE + REGIMES ============ *@
<div class="mt-12 grid gap-5 lg:grid-cols-[1fr_1.4fr]">
    <section class="rounded-[1.75rem] bg-[#ADEE68] p-6 text-[#001F3E] sm:p-8 lg:self-start">
        <span class="rounded-full bg-white/75 px-3 py-1 text-xs font-bold">Check it against your COR</span>
        <h2 class="mt-4 text-3xl font-extrabold leading-tight tracking-tighter">Match what’s printed on your Form 2303.</h2>
        <ol class="mt-5 space-y-3 text-sm">
            @foreach (var (step, i) in CorSteps.Select((text, index) => (text, index + 1)))
            {
                <li class="flex items-start gap-3">
                    <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-[#001F3E] text-xs font-extrabold text-white" aria-hidden="true">@i</span>
                    <span>@step</span>
                </li>
            }
        </ol>
    </section>

    <section class="rounded-[1.75rem] border border-[#E2E8F0] bg-white p-6 sm:p-8">
        <h2 class="text-3xl font-extrabold leading-tight tracking-tighter">Regimes in plain words</h2>
        <div class="mt-5 grid gap-5 sm:grid-cols-2">
            <div>
                <h3 class="text-xs font-extrabold uppercase tracking-widest text-[#0F69C5]">Income tax</h3>
                <dl class="mt-3 space-y-4 text-sm">
                    @foreach (var (term, meaning) in IncomeTaxTerms)
                    {
                        <div><dt class="font-extrabold">@term</dt><dd class="mt-0.5 text-[#5B6B7F]">@meaning</dd></div>
                    }
                </dl>
            </div>
            <div>
                <h3 class="text-xs font-extrabold uppercase tracking-widest text-[#0F69C5]">Business tax</h3>
                <dl class="mt-3 space-y-4 text-sm">
                    @foreach (var (term, meaning) in BusinessTaxTerms)
                    {
                        <div><dt class="font-extrabold">@term</dt><dd class="mt-0.5 text-[#5B6B7F]">@meaning</dd></div>
                    }
                </dl>
            </div>
        </div>
        <p class="mt-6 rounded-2xl bg-[#F6F9FC] px-4 py-3 text-xs text-[#5B6B7F]">Thresholds and rates change. Confirm what applies to you on your COR and in current BIR issuances.</p>
    </section>
</div>

<BusinessDrawer Open="drawerOpen" Editing="editing" OnClose="CloseDrawer" OnSave="SaveAsync" />

@code {
    /// <summary>Lets other pages link here with the add form already open: /businesses?add=true</summary>
    [SupplyParameterFromQuery(Name = "add")] public bool AddRequested { get; set; }

    private bool drawerOpen;
    private Business? editing;
    private string? notice;

    private static readonly string[] CorSteps =
    {
        "Open your Certificate of Registration (BIR Form 2303).",
        "Find the RDO code near the top. It’s a 3-digit number.",
        "Look at the tax types section. It lists the forms you’re registered to file.",
        "Pick the same regime and tax type here so your deadlines come out right.",
    };

    private static readonly (string Term, string Meaning)[] IncomeTaxTerms =
    {
        ("8% flat", "A simpler option for many freelancers and self-employed people. A flat 8% on gross receipts above ₱250,000, in place of graduated income tax and percentage tax."),
        ("Graduated + OSD", "Regular graduated rates applied to your gross less a standard 40% deduction, with no need to prove expenses."),
        ("Graduated + itemized", "Graduated rates applied to your income after deducting your actual, documented business expenses."),
    };

    private static readonly (string Term, string Meaning)[] BusinessTaxTerms =
    {
        ("Percentage Tax", "A tax on your gross receipts each quarter (Form 2551Q) for small businesses that aren’t VAT-registered."),
        ("VAT", "Value-added tax on your sales, filed quarterly (Form 2550Q). Required once sales pass the VAT threshold, and optional before that."),
        ("Income tax only", "Used with the 8% option, which already covers percentage tax."),
    };

    protected override void OnInitialized() => Workspace.Changed += OnWorkspaceChanged;

    protected override void OnParametersSet()
    {
        if (AddRequested && !drawerOpen)
        {
            OpenAdd();
            Nav.NavigateTo("/businesses", replace: true);
        }
    }

    private void OnWorkspaceChanged() => InvokeAsync(StateHasChanged);

    private void OpenAdd()
    {
        editing = null;
        drawerOpen = true;
    }

    private void OpenEdit(Business business)
    {
        editing = business;
        drawerOpen = true;
    }

    private void CloseDrawer() => drawerOpen = false;

    private void SwitchTo(Business business)
    {
        Workspace.Select(business.Id);
        notice = $"Now viewing {business.Name}.";
    }

    private void OpenDashboard(Business business) => Nav.NavigateTo("/dashboard");

    private Task SaveAsync(BusinessFormModel form)
    {
        if (editing is null)
        {
            var added = Workspace.AddBusiness(form);
            notice = $"Added {added.Name}. We created starter deadlines from its tax type, so check them against your COR.";
        }
        else
        {
            Workspace.UpdateBusiness(editing.Id, form);
            notice = $"Saved changes to {form.Name.Trim()}.";
        }

        drawerOpen = false;
        return Task.CompletedTask;
    }

    public void Dispose() => Workspace.Changed -= OnWorkspaceChanged;
}

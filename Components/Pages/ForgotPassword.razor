@page "/forgot-password"
@layout AuthLayout
@inject IAuthService Auth

<PageTitle>Reset your password | BIRa</PageTitle>

@if (sentTo is not null)
{
    <AuthNotice Title="Check your email" Icon="✉️">
        <ChildContent>
        If an account exists for <span class="font-bold text-[#001F3E]">@sentTo</span>, we’ve sent a link to reset your password. It can take a few minutes, so check your spam folder too. This is a demo, so no email was actually sent.
        </ChildContent>
        <Actions>
            <a href="/login" class="block rounded-full bg-[#0F69C5] px-6 py-3 font-bold text-white transition hover:brightness-110">Back to log in</a>
            <button type="button" class="block w-full rounded-full border border-[#E2E8F0] px-6 py-3 font-bold transition hover:bg-[#EEF3F9]" @onclick="TryAnother">Use a different email</button>
        </Actions>
    </AuthNotice>
}
else
{
    <h1 class="text-3xl font-extrabold leading-tight tracking-tighter sm:text-4xl">Forgot your password?</h1>
    <p class="mt-2 text-[#5B6B7F]">No problem. Enter your email and we’ll send you a link to choose a new one.</p>

    <EditForm Model="model" OnValidSubmit="SubmitAsync" class="mt-8 space-y-5">
        <DataAnnotationsValidator />

        @if (error is not null)
        {
            <p class="rounded-2xl bg-[#ED3F27]/10 px-4 py-3 text-sm font-semibold text-[#B42A16]" role="alert">@error</p>
        }

        <AuthField Label="Email" InputId="forgot-email">
            <InputText id="forgot-email" type="email" autocomplete="email" placeholder="you@example.com" class="@AuthField.InputClass" @bind-Value="model.Email" />
            <ValidationMessage For="() => model.Email" class="mt-1.5 block text-xs font-semibold text-[#ED3F27]" />
        </AuthField>

        <AuthSubmit Text="Send reset link" BusyText="Sending..." Busy="busy" />
    </EditForm>

    <p class="mt-6 text-center text-sm text-[#5B6B7F]">
        Remembered it?
        <a href="/login" class="font-bold text-[#0F69C5] hover:underline">Back to log in</a>
    </p>
}

@code {
    private readonly ForgotPasswordModel model = new();
    private bool busy;
    private string? sentTo;
    private string? error;

    private async Task SubmitAsync()
    {
        busy = true;
        error = null;

        var result = await Auth.SendPasswordResetAsync(model);

        busy = false;
        if (result.Succeeded) sentTo = model.Email;
        else error = result.Error ?? "We couldn’t send the link. Please try again.";
    }

    private void TryAnother()
    {
        model.Email = "";
        sentTo = null;
    }
}

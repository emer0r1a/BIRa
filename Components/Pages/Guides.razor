@page "/guides"
@layout DashboardLayout
@implements IDisposable
@inject WorkspaceState Workspace
@inject NavigationManager Nav

<PageTitle>Guides and checklist | BIRa</PageTitle>

@* ============ HEADER ============ *@
<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <h1 class="text-3xl font-extrabold leading-tight tracking-tighter sm:text-5xl">Guides and checklist</h1>
        <p class="mt-1 max-w-xl text-[#5B6B7F]">Short, plain-language workflows. Tick things off as you go. Your progress is saved for each business.</p>
    </div>
    <ul class="flex flex-wrap gap-2 text-xs font-bold">
        <li class="rounded-full border border-[#E2E8F0] bg-white px-3 py-1.5">For @Workspace.Current.Name</li>
        <li class="rounded-full border border-[#E2E8F0] bg-white px-3 py-1.5">@Workspace.Current.Regime</li>
        <li class="rounded-full border border-[#E2E8F0] bg-white px-3 py-1.5">@Workspace.Current.TaxType</li>
    </ul>
</div>

<div class="mt-8 grid gap-6 lg:grid-cols-[360px_1fr]">

    @* ============ GUIDE LIST ============ *@
    <div>
        <div class="flex flex-wrap gap-2" role="group" aria-label="Filter guides by category">
            @foreach (var (label, value) in Filters)
            {
                <button type="button"
                        class="rounded-full border px-4 py-2 text-sm font-semibold transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0F69C5] @(category == value ? "border-[#001F3E] bg-[#001F3E] text-white" : "border-[#E2E8F0] bg-white hover:border-[#0F69C5]")"
                        aria-pressed="@(category == value ? "true" : "false")"
                        @onclick="() => category = value">@label</button>
            }
        </div>

        <ul class="mt-4 space-y-3">
            @foreach (var g in VisibleGuides)
            {
                <li><GuideCard Item="g" Selected="g.Id == selectedId" Done="DoneCount(g)" Total="TotalCount(g)" OnSelect="SelectGuide" /></li>
            }
        </ul>

        <p class="mt-4 rounded-2xl bg-white px-4 py-3 text-xs text-[#5B6B7F] border border-[#E2E8F0]">Requirements can differ by city and BIR office. Confirm with your RDO and your COR.</p>
    </div>

    @* ============ CHECKLIST ============ *@
    <section class="min-w-0" aria-labelledby="guide-title">
        <div class="rounded-[1.75rem] border border-[#E2E8F0] bg-white p-5 sm:p-8">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                <div>
                    <p class="text-xs font-extrabold uppercase tracking-widest text-[#0F69C5]">@Selected.Category</p>
                    <h2 id="guide-title" class="mt-1 text-3xl font-extrabold leading-tight tracking-tighter sm:text-4xl">@Selected.Title</h2>
                    <p class="mt-1 max-w-lg text-[#5B6B7F]">@Selected.Summary</p>
                </div>
                <button type="button" class="w-fit shrink-0 rounded-full border border-[#E2E8F0] px-4 py-2 text-sm font-bold transition hover:bg-[#EEF3F9] disabled:cursor-not-allowed disabled:opacity-40" disabled="@(DoneCount(Selected) == 0)" @onclick="Reset">Reset progress</button>
            </div>

            <div class="mt-6" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Percent" aria-label="Checklist progress">
                <div class="flex items-center justify-between text-sm font-bold">
                    <span>@DoneCount(Selected) of @Steps.Count done</span>
                    <span class="rounded-full bg-[#ADEE68] px-2.5 py-0.5 text-xs text-[#001F3E]">@Percent%</span>
                </div>
                <div class="mt-2 h-2.5 overflow-hidden rounded-full bg-[#EEF3F9]">
                    <div class="h-full rounded-full bg-gradient-to-r from-[#ADEE68] to-[#1FBCCF] transition-all duration-300" style="width: @Percent%"></div>
                </div>
            </div>

            @if (Selected.LinkedToDeadline)
            {
                <div class="mt-5 flex flex-col gap-3 rounded-2xl bg-[#001F3E] p-4 text-white sm:flex-row sm:items-center sm:justify-between">
                    @if (NextDeadline is null)
                    {
                        <p class="text-sm"><span class="font-extrabold">All caught up.</span> Nothing is waiting to be filed for this business.</p>
                    }
                    else
                    {
                        <div class="min-w-0">
                            <p class="text-xs font-bold uppercase tracking-widest text-[#A9BBD1]">Preparing for</p>
                            <p class="font-extrabold">@NextDeadline.FormCode · @NextDeadline.Title</p>
                            <p class="text-sm text-[#A9BBD1]">@NextDeadline.Period · due @NextDeadline.DueDate.ToString("MMM d") · @NextDeadline.RelativeText(Workspace.Today)</p>
                        </div>
                        <div class="flex shrink-0 items-center gap-3">
                            <StatusBadge Status="NextDeadline.StatusOn(Workspace.Today)" />
                            <a href="/dashboard" class="rounded-full bg-[#ADEE68] px-4 py-2 text-sm font-bold text-[#001F3E] transition hover:brightness-95">Open dashboard</a>
                        </div>
                    }
                </div>
            }

            @if (Steps.Count > 0 && DoneCount(Selected) == Steps.Count)
            {
                <div class="mt-5 flex items-start gap-4 rounded-2xl bg-[#ADEE68] p-5 text-[#001F3E]" role="status">
                    <span class="text-3xl" aria-hidden="true">🎉</span>
                    <div>
                        <p class="text-lg font-extrabold leading-tight">Checklist complete</p>
                        <p class="mt-1 text-sm">Nice work. @(Selected.LinkedToDeadline ? "You’re ready to file. Double-check the due date on your dashboard." : "You’ve covered every step in this guide.")</p>
                    </div>
                </div>
            }

            <ol class="mt-6 space-y-3">
                @foreach (var (step, index) in Steps.Select((item, i) => (item, i + 1)))
                {
                    <ChecklistStep Item="step" Number="index" IsDone="Workspace.IsStepDone(Workspace.Current.Id, selectedId, step.Id)" OnToggle="Toggle" />
                }
            </ol>

            @if (DocumentSummary.Count > 0)
            {
                <div class="mt-8 rounded-2xl bg-[#F6F9FC] p-5">
                    <h3 class="text-sm font-extrabold uppercase tracking-widest text-[#5B6B7F]">Documents you’ll need</h3>
                    <ul class="mt-3 flex flex-wrap gap-2">
                        @foreach (var (doc, count) in DocumentSummary)
                        {
                            <li><DocTag Name="@doc" Count="count" /></li>
                        }
                    </ul>
                </div>
            }
        </div>
    </section>
</div>

@code {
    /// <summary>Lets other pages link to a guide: /guides?guide=quarterly-filing</summary>
    [SupplyParameterFromQuery(Name = "guide")] public string? GuideParam { get; set; }

    private string selectedId = "quarterly-filing";
    private string? appliedParam;
    private string? category;

    private static readonly (string Label, string? Value)[] Filters =
    {
        ("All", null),
        (GuideCatalog.Registration, GuideCatalog.Registration),
        (GuideCatalog.Filing, GuideCatalog.Filing),
        (GuideCatalog.Records, GuideCatalog.Records),
    };

    private Guide Selected => GuideCatalog.Find(selectedId) ?? GuideCatalog.All[0];

    private IEnumerable<Guide> VisibleGuides => GuideCatalog.All.Where(g => category is null || g.Category == category);

    private List<GuideStep> Steps => GuideCatalog.StepsFor(Selected.Id, Workspace.Current);

    private int Percent => Steps.Count == 0 ? 0 : (int)Math.Round(DoneCount(Selected) * 100.0 / Steps.Count);

    private Deadline? NextDeadline => Workspace.CurrentDeadlines.FirstOrDefault(d => !d.IsFiled);

    private List<(string Doc, int Count)> DocumentSummary => Steps
        .SelectMany(s => s.Documents)
        .GroupBy(d => d)
        .Select(g => (g.Key, g.Count()))
        .OrderByDescending(t => t.Item2)
        .ThenBy(t => t.Key)
        .ToList();

    private int TotalCount(Guide guide) => GuideCatalog.StepsFor(guide.Id, Workspace.Current).Count;

    private int DoneCount(Guide guide) => GuideCatalog.StepsFor(guide.Id, Workspace.Current)
        .Count(s => Workspace.IsStepDone(Workspace.Current.Id, guide.Id, s.Id));

    protected override void OnInitialized() => Workspace.Changed += OnWorkspaceChanged;

    protected override void OnParametersSet()
    {
        // Apply ?guide=... once, so clicking around afterwards isn't overridden.
        if (GuideParam != appliedParam)
        {
            appliedParam = GuideParam;
            if (GuideCatalog.Find(GuideParam) is { } guide)
            {
                selectedId = guide.Id;
                category = null;
            }
        }
    }

    private void OnWorkspaceChanged() => InvokeAsync(StateHasChanged);

    private void SelectGuide(Guide guide) => selectedId = guide.Id;

    private void Toggle(GuideStep step) => Workspace.ToggleStep(Workspace.Current.Id, selectedId, step.Id);

    private void Reset() => Workspace.ResetGuide(Workspace.Current.Id, selectedId);

    public void Dispose() => Workspace.Changed -= OnWorkspaceChanged;
}

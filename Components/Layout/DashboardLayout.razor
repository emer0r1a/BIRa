@inherits LayoutComponentBase
@inject WorkspaceState Workspace

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</HeadContent>

<div class="min-h-screen w-full bg-[#F6F9FC] text-[#001F3E] font-['Plus_Jakarta_Sans',ui-sans-serif,system-ui,sans-serif] antialiased selection:bg-[#ADEE68] lg:grid lg:grid-cols-[272px_1fr]">

    @if (menuOpen)
    {
        <button type="button" class="fixed inset-0 z-40 bg-[#001F3E]/50 lg:hidden" aria-label="Close menu" @onclick="() => menuOpen = false"></button>
    }

    @* ============ SIDEBAR ============ *@
    <aside class="fixed inset-y-0 left-0 z-50 flex w-72 flex-col gap-5 overflow-y-auto bg-[#001F3E] p-4 text-[#C5D3E4] transition-transform duration-200 lg:sticky lg:top-0 lg:h-screen lg:w-auto lg:translate-x-0 @(menuOpen ? "translate-x-0" : "-translate-x-full")">
        <div class="flex items-center justify-between px-1 pt-1">
            <a href="/" class="flex items-center gap-2.5 rounded-lg text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#ADEE68]">
                <BiraLogo Class="h-8 w-8" InnerColor="#001F3E" />
                <span class="text-2xl font-extrabold tracking-tighter">BIRa</span>
            </a>
            <button type="button" class="grid h-9 w-9 place-items-center rounded-full bg-white/10 text-white lg:hidden" aria-label="Close menu" @onclick="() => menuOpen = false">✕</button>
        </div>

        <WorkspaceSwitcher />

        <nav aria-label="Dashboard" class="flex flex-col gap-1">
            @foreach (var item in NavItems)
            {
                if (item.Soon)
                {
                    <span class="flex cursor-not-allowed items-center gap-3 rounded-xl px-3 py-2.5 font-semibold opacity-60" aria-disabled="true">
                        <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="@item.Icon" /></svg>
                        @item.Label
                        <span class="ml-auto rounded-full bg-white/10 px-2 py-0.5 text-[10px] font-bold">Soon</span>
                    </span>
                }
                else
                {
                    <NavLink href="@item.Href" ActiveClass="!bg-[#0F69C5] text-white" class="flex items-center gap-3 rounded-xl px-3 py-2.5 font-semibold transition hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-[#ADEE68]" @onclick="() => menuOpen = false">
                        <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="@item.Icon" /></svg>
                        @item.Label
                    </NavLink>
                }
            }
        </nav>

        <div class="mt-auto flex items-center gap-3 rounded-2xl bg-white/10 p-3">
            <Avatar Name="@Workspace.UserName" Class="h-10 w-10 text-sm bg-[#ADEE68] text-[#001F3E]" />
            <div class="min-w-0 flex-1 leading-tight">
                <p class="truncate text-sm font-extrabold text-white">@Workspace.UserName</p>
                <a href="/login" class="text-xs font-semibold text-[#A9BBD1] underline-offset-2 hover:text-white hover:underline">Log out</a>
            </div>
        </div>
    </aside>

    @* ============ CONTENT ============ *@
    <div class="flex min-w-0 flex-col">
        <div class="sticky top-0 z-30 flex items-center gap-3 border-b border-[#E2E8F0] bg-[#F6F9FC]/90 px-4 py-3 backdrop-blur-lg lg:hidden">
            <button type="button" class="grid h-11 w-11 place-items-center rounded-full border border-[#E2E8F0] bg-white" aria-label="Open menu" @onclick="() => menuOpen = true">
                <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            </button>
            <span class="text-xl font-extrabold tracking-tighter">BIRa</span>
        </div>

        <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-6 sm:px-8 sm:py-8">
            @Body
        </main>

        <footer class="mx-auto w-full max-w-6xl px-4 pb-8 sm:px-8">
            <p class="rounded-2xl border border-[#E2E8F0] bg-white px-5 py-3 text-xs text-[#5B6B7F]">Informational aid only. Verify deadlines and tax types against your official BIR Form 2303 COR and issuances.</p>
        </footer>
    </div>
</div>

@code {
    private bool menuOpen;

    private record NavItem(string Label, string Href, string Icon, bool Soon = false);

    private static readonly List<NavItem> NavItems = new()
    {
        new("Dashboard", "/dashboard", "M4 4h7v9H4zM13 4h7v5h-7zM13 11h7v9h-7zM4 15h7v5H4z"),
        new("My businesses", "/businesses", "M3 21h18M5 21V8l7-5 7 5v13M9 21v-6h6v6"),
        new("Guides and checklist", "/guides", "M9 11l3 3 8-8M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9"),
        new("Tax estimator", "/estimator", "M6 2h12a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zM8 7h8M8 12h2M14 12h2M8 17h2M14 17h2", Soon: true),
        new("Knowledge hub", "/hub", "M4 5a2 2 0 0 1 2-2h12v18H6a2 2 0 0 1-2-2zM8 7h6M8 11h6", Soon: true),
        new("Community", "/community", "M21 12a8 8 0 0 1-11.5 7.2L3 21l1.8-6.5A8 8 0 1 1 21 12z", Soon: true),
    };
}

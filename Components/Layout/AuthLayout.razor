@inherits LayoutComponentBase

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</HeadContent>

<div class="min-h-screen w-full bg-[#F6F9FC] text-[#001F3E] font-['Plus_Jakarta_Sans',ui-sans-serif,system-ui,sans-serif] antialiased selection:bg-[#ADEE68] lg:grid lg:grid-cols-[1.05fr_1fr]">

    @* ============ BRAND PANEL (desktop) ============ *@
    <aside class="relative hidden flex-col justify-between overflow-hidden bg-[#001F3E] p-12 text-white lg:flex">
        <div class="pointer-events-none absolute -right-24 -top-24 h-96 w-96 rounded-full bg-[#ADEE68]/70 blur-3xl" aria-hidden="true"></div>
        <div class="pointer-events-none absolute -bottom-32 -left-24 h-96 w-96 rounded-full bg-[#1FBCCF]/50 blur-3xl" aria-hidden="true"></div>

        <a href="/" class="relative flex w-fit items-center gap-2.5 rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#ADEE68]">
            <BiraLogo Class="h-9 w-9" InnerColor="#001F3E" />
            <span class="text-2xl font-extrabold tracking-tighter">BIRa</span>
        </a>

        <div class="relative">
            <h2 class="max-w-md text-5xl font-extrabold leading-[0.98] tracking-tighter xl:text-6xl">
                Your BIR deadlines, in one
                <span class="mt-1 inline-block -rotate-1 rounded-2xl bg-[#ADEE68] px-3 pb-1 text-[#001F3E]">calm place.</span>
            </h2>

            <ul class="mt-8 space-y-3 text-[15px] text-[#C5D3E4]">
                @foreach (var point in Points)
                {
                    <li class="flex items-center gap-3">
                        <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-[#ADEE68] text-xs font-extrabold text-[#001F3E]" aria-hidden="true">✓</span>
                        @point
                    </li>
                }
            </ul>

            <div class="mt-10 max-w-sm rounded-3xl border border-white/15 bg-white/10 p-5 backdrop-blur-md">
                <div class="flex items-center justify-between">
                    <p class="text-xs text-[#A9BBD1]">Next filing</p>
                    <span class="rounded-full bg-[#FEB21A] px-2.5 py-0.5 text-xs font-bold text-[#001F3E]">Due soon</span>
                </div>
                <p class="mt-1 text-lg font-extrabold">2551Q · Percentage Tax</p>
                <p class="text-sm text-[#A9BBD1]">Due in 12 days</p>
                <div class="mt-3 h-2 overflow-hidden rounded-full bg-white/15"><div class="h-full w-2/5 rounded-full bg-gradient-to-r from-[#ADEE68] to-[#1FBCCF]"></div></div>
                <div class="mt-4 flex items-center gap-3">
                    <div class="flex -space-x-2">
                        <Avatar Name="Maria Reyes" Class="h-8 w-8 text-xs bg-[#ADEE68] text-[#001F3E]" />
                        <Avatar Name="Kape ni Ate Joy" Class="h-8 w-8 text-xs bg-white text-[#001F3E]" />
                        <Avatar Name="JR Print Hub" Class="h-8 w-8 text-xs bg-[#1FBCCF] text-[#001F3E]" />
                    </div>
                    <p class="text-xs text-[#A9BBD1]">Switch between businesses in one tap</p>
                </div>
            </div>
        </div>

        <p class="relative max-w-sm text-xs text-[#A9BBD1]">Informational aid only. Verify deadlines and tax types against your official BIR Form 2303 COR and issuances.</p>
    </aside>

    @* ============ FORM SIDE ============ *@
    <main class="flex min-h-screen flex-col px-4 py-6 sm:px-10">
        <div class="flex items-center justify-between">
            <a href="/" class="flex items-center gap-2.5 rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#0F69C5] lg:invisible">
                <BiraLogo Class="h-8 w-8" />
                <span class="text-2xl font-extrabold tracking-tighter">BIRa</span>
            </a>
            <a href="/" class="rounded-full border border-[#E2E8F0] bg-white px-4 py-2 text-sm font-semibold text-[#5B6B7F] transition hover:text-[#001F3E]">← Back to home</a>
        </div>

        <div class="mx-auto flex w-full max-w-md flex-1 flex-col justify-center py-8">
            <div class="rounded-[2rem] border border-[#E2E8F0] bg-white p-7 shadow-[0_30px_60px_-35px_rgba(0,31,62,0.35)] sm:p-9">
                @Body
            </div>
        </div>

        <p class="text-center text-xs text-[#5B6B7F] lg:hidden">Informational aid only. Verify deadlines against your official BIR Form 2303 COR.</p>
    </main>
</div>

@code {
    private static readonly string[] Points =
    {
        "Deadlines adjusted for weekends and holidays",
        "Plain-language guides and checklists",
        "Tax and penalty estimates before you file",
    };
}

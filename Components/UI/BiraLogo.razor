<svg viewBox="0 0 32 32" class="@Class" aria-hidden="true">
    <defs>
        <linearGradient id="biraLogoGrad" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#1FBCCF" />
            <stop offset="0.55" stop-color="#0F69C5" />
            <stop offset="1" stop-color="#ADEE68" />
        </linearGradient>
    </defs>
    <circle cx="16" cy="16" r="16" fill="url(#biraLogoGrad)" />
    <circle cx="16" cy="16" r="6.5" fill="@InnerColor" />
</svg>

@code {
    [Parameter] public string Class { get; set; } = "h-8 w-8";

    /// Colour of the centre dot. Match it to whatever the logo sits on.
    [Parameter] public string InnerColor { get; set; } = "#F6F9FC";
}

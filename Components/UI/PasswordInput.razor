@using System.Diagnostics.CodeAnalysis
@inherits InputBase<string>

<div class="relative">
    <input @attributes="AdditionalAttributes"
           type="@(visible ? "text" : "password")"
           class="@CssClass @AuthField.InputClass pr-20"
           @bind="CurrentValueAsString"
           @bind:event="oninput" />
    <button type="button"
            class="absolute right-2 top-1/2 -translate-y-1/2 rounded-xl px-3 py-1.5 text-xs font-bold text-[#0F69C5] transition hover:bg-[#EEF3F9] focus-visible:outline-2 focus-visible:outline-[#0F69C5]"
            aria-label="@(visible ? "Hide password" : "Show password")"
            aria-pressed="@(visible ? "true" : "false")"
            @onclick="() => visible = !visible">@(visible ? "Hide" : "Show")</button>
</div>

@code {
    private bool visible;

    protected override bool TryParseValueFromString(string? value, [MaybeNullWhen(false)] out string result, [NotNullWhen(false)] out string? validationErrorMessage)
    {
        result = value ?? "";
        validationErrorMessage = null;
        return true;
    }
}

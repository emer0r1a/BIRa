<div class="rounded-3xl border border-white/80 bg-white/60 p-4 shadow-[0_24px_50px_-24px_rgba(0,31,62,0.4)] backdrop-blur-xl @Class">
    <div class="flex items-center gap-3">
        <span class="relative">
            <span class="grid h-10 w-10 place-items-center rounded-full bg-gradient-to-br from-[#ADEE68] to-[#1FBCCF] text-sm font-extrabold text-[#001F3E]" aria-hidden="true">B</span>
            <span class="absolute -right-0.5 -top-0.5 h-3 w-3 rounded-full border-2 border-white bg-[#ADEE68]" aria-hidden="true"></span>
        </span>
        <div class="leading-tight">
            <p class="text-sm font-extrabold">BIRa Assistant</p>
            <p class="text-xs text-[#4A6580]">Tax guide · online</p>
        </div>
    </div>

    <div class="mt-4 flex min-h-[9.5rem] flex-col gap-2" aria-live="polite">
        @foreach (var m in messages.TakeLast(4))
        {
            <p class="@(m.FromUser
                ? "max-w-[88%] self-end rounded-2xl rounded-br-sm bg-[#001F3E] px-3.5 py-2 text-[13px] leading-snug text-white"
                : "max-w-[92%] self-start rounded-2xl rounded-bl-sm bg-[#ADEE68] px-3.5 py-2 text-[13px] leading-snug text-[#001F3E]")">@m.Text</p>
        }
    </div>

    <div class="mt-3 flex flex-wrap gap-1.5">
        @foreach (var q in Answers.Keys)
        {
            <button type="button"
                    class="rounded-full border border-[#001F3E]/20 bg-white/70 px-3 py-1.5 text-xs font-bold transition hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0F69C5]"
                    @onclick="() => Ask(q)">@q</button>
        }
    </div>
</div>

@code {
    [Parameter] public string Class { get; set; } = "";

    private record Message(bool FromUser, string Text);

    private readonly List<Message> messages = new()
    {
        new(false, "Kumusta! Ask me about a form, a due date or a penalty."),
    };

    private static readonly Dictionary<string, string> Answers = new()
    {
        ["What is Form 2307?"] = "It’s a certificate your client gives you when they withhold tax from your payment. Keep it. It can reduce what you owe.",
        ["8% or graduated?"] = "The 8% option is simpler for many freelancers. Graduated rates with OSD can win when costs are high. Try both, then check eligibility against your COR.",
        ["I filed late. Now what?"] = "File as soon as you can. Surcharge and interest grow with time. The penalty calculator in the app shows the breakdown.",
    };

    private void Ask(string question)
    {
        messages.Add(new(true, question));
        messages.Add(new(false, Answers[question]));
    }
}

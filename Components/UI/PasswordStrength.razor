<div class="mt-2.5" aria-live="polite">
    <div class="flex gap-1.5" aria-hidden="true">
        @for (var i = 1; i <= 4; i++)
        {
            <span class="h-1.5 flex-1 rounded-full transition-colors @(i <= Score ? BarColor : "bg-[#E2E8F0]")"></span>
        }
    </div>
    <p class="mt-1.5 text-xs font-bold text-[#5B6B7F]">Password strength: @Label</p>
    <ul class="mt-2 grid gap-1 text-xs">
        @foreach (var (text, met) in Rules)
        {
            <li class="flex items-center gap-2 @(met ? "font-semibold text-[#2C7A00]" : "text-[#5B6B7F]")">
                <span class="w-3 text-center" aria-hidden="true">@(met ? "✓" : "○")</span>@text
            </li>
        }
    </ul>
</div>

@code {
    [Parameter] public string Password { get; set; } = "";

    private IEnumerable<(string Text, bool Met)> Rules => new[]
    {
        ("At least 8 characters", Password.Length >= 8),
        ("A letter and a number", Password.Any(char.IsLetter) && Password.Any(char.IsDigit)),
        ("12+ characters or a symbol", Password.Length >= 12 || Password.Any(c => !char.IsLetterOrDigit(c))),
    };

    /// <summary>0 when empty, otherwise 1 (weak) to 4 (strong, all rules met and 12+ characters).</summary>
    private int Score
    {
        get
        {
            if (string.IsNullOrEmpty(Password)) return 0;
            var met = Rules.Count(r => r.Met);
            return Math.Max(1, met + (met == 3 && Password.Length >= 12 ? 1 : 0));
        }
    }

    private string Label => Score switch { 0 => "—", 1 => "Weak", 2 => "Fair", 3 => "Good", _ => "Strong" };

    // Blue and lime scale, so the alert colours stay reserved for deadlines and penalties.
    private string BarColor => Score switch { 1 => "bg-[#8A9BB0]", 2 => "bg-[#1FBCCF]", 3 => "bg-[#0F69C5]", _ => "bg-[#ADEE68]" };
}
